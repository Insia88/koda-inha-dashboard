{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "ko-KR",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Date", "Form", "Scrollbar", "Toast", "CRUD"],
  "ownership": {
    "Select/Listbox": "native",
    "Date": "native"
  },
  "requiredCommands": ["unit", "e2e", "accessibility", "premium"],
  "commands": {
    "unit": "npm test",
    "e2e": "npm run build && npm run e2e",
    "accessibility": "npm run build && npx playwright test e2e/a11y.spec.ts",
    "premium": "<bundled python> <frontend-design-premium>/scripts/audit_project.py . --mode strict --output artifacts/premium-audit.json"
  },
  "evidence": {
    "crudFullFlow": "e2e/flow.spec.ts",
    "failurePaths": "e2e/interaction.spec.ts"
  }
}
