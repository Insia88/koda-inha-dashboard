# 개발 환경 예시. 실제 비밀값을 넣지 마세요.
NODE_ENV=development
# 127.0.0.1 이외 주소는 기동을 거부한다(같은 네트워크의 누구나 개발용 로그인을 쓸 수 있게 되므로).
HOST=127.0.0.1
PORT=4300
# 저장 파일 경로 (app/ 기준). ':memory:'는 메모리 DB(재시작하면 사라짐)
DB_PATH=./data/koda-dev.sqlite
# dev: 개발용 모의 로그인. VERCEL=1 또는 NODE_ENV=production이면 DEMO_PUBLIC=1 없이는 기동을 거부한다. 운영 SSO 어댑터(oidc)는 미구현.
AUTH_MODE=dev
# 세션 만료(분). 미지정 시 로컬 480, 공개 데모 120. 공개 데모 세션은 서버에서 폐기할 수 없으므로 늘리지 않는다.
SESSION_TTL_MINUTES=480
# 모의 커스터디 처리 지연(ms). 미지정 시 config/policy.json 값
# MOCK_CUSTODY_PROCESSING_MS=4000
# 새 주소 사용 대기 시간(시간). 두 번째 사람이 확인한 주소는 이 시간 동안 '사용 대기'라 출금 요청에 쓸 수 없다.
# 미지정 시 config/policy.json addressBook.cooldownHours(24, 설계 가정 A-31). 0이면 확인 즉시 사용 가능:
# 한 번에 등록 → 확인 → 출금 요청까지 시연할 때와 E2E(playwright.config.ts)가 이 값을 쓴다.
# ADDRESS_COOLDOWN_HOURS=24
# 모의 시세 기준 시각 갱신. off면 갱신을 멈춰 30분 뒤 평가액에 '시세 지연'이 보인다(미지정 시 갱신).
# MOCK_PRICE_FEED=off
# 요청 한도(1분당, IP 기준). 전체 API / 개발용 로그인
# RATE_LIMIT_MAX=600
# LOGIN_RATE_LIMIT_MAX=30

# --- 같은 네트워크에서 확인할 때만 ---
# HOST를 127.0.0.1 이외로 열 때 1. 비밀번호 없는 개발용 로그인이 같은 네트워크에 열리므로 확인이 끝나면 지운다.
# DEV_ALLOW_LAN=1

# --- 공개 데모(Vercel) 전용: Vercel 프로젝트 환경변수에만 설정하고 로컬 .env에는 넣지 않는다 ---
# docs/deploy-vercel.md 참고. 설정하면 메모리 DB, Secure 쿠키, 프록시 IP 신뢰, 요청 시점 정산, 생성 건수 제한이 켜진다.
# NODE_ENV·AUTH_MODE·DB_PATH는 Vercel에 설정하지 않는다.
# DEMO_PUBLIC=1
# Vercel이 요청 본문을 미리 해석하지 않고 Fastify에 그대로 넘기게 한다.
# NODEJS_HELPERS=0
# 세션 쿠키·CSRF 값 서명 키(32바이트 이상 무작위 값). 없거나 짧으면 공개 데모가 기동을 거부한다. 로컬은 읽지 않는다.
# 공개 데모 세션은 서명된 쿠키(무상태)라 어느 함수 인스턴스가 받아도 로그인이 유지된다. 데이터 쓰기는 여전히 인스턴스마다 따로다.
# 만들기: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 만든 값은 Vercel 프로젝트 환경변수(Production·Preview)에만 넣고, 이 파일·.env·저장소·문서·로그에는 절대 남기지 않는다.
# 서버에서 세션을 폐기할 수 없으므로, 모든 세션을 끊으려면 이 값을 새로 만들어 바꾼 뒤 다시 배포한다.
# DEMO_SESSION_SECRET=
