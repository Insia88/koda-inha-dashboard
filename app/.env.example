# 개발 환경 예시. 실제 비밀값을 넣지 마세요.
NODE_ENV=development
HOST=127.0.0.1
PORT=4300
# 저장 파일 경로 (app/ 기준)
DB_PATH=./data/koda-dev.sqlite
# dev: 개발용 모의 로그인. production에서는 dev가 거부된다. 운영 SSO 어댑터(oidc)는 미구현.
AUTH_MODE=dev
# 세션 만료(분)
SESSION_TTL_MINUTES=480
# 모의 커스터디 처리 지연(ms). 미지정 시 config/policy.json 값
# MOCK_CUSTODY_PROCESSING_MS=4000
# 요청 한도(1분당, IP 기준). 전체 API / 개발용 로그인
# RATE_LIMIT_MAX=600
# LOGIN_RATE_LIMIT_MAX=30
